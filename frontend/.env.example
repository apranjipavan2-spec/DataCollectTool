# ──────────────────────────────────────────────────────────────────────────────
# FieldGovern Frontend — Environment Variables
# Copy to .env and fill in before building.
# All VITE_ vars are baked into the build at compile time.
# ──────────────────────────────────────────────────────────────────────────────

# ── API (REQUIRED) ────────────────────────────────────────────────────────────
# Backend base URL — no trailing slash, no /api/v1 suffix
VITE_API_BASE_URL=https://app.fieldgovern.com/api/v1

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Same value as GOOGLE_CLIENT_ID in backend/.env
# Leave empty to hide the Google Sign-In button.
VITE_GOOGLE_CLIENT_ID=

# ── Cloudflare Turnstile — bot protection on trial signup ─────────────────────
# Site key from dash.cloudflare.com → Turnstile (secret goes in backend/.env as
# TURNSTILE_SECRET). Leave empty to hide the CAPTCHA widget (dev).
VITE_TURNSTILE_SITE_KEY=

# ── Push Notifications (optional) ─────────────────────────────────────────────
# Same value as VAPID_PUBLIC_KEY from backend/.env
VITE_VAPID_PUBLIC_KEY=

# ── Error Monitoring (optional) ───────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── Product Analytics (optional) ─────────────────────────────────────────────
# PostHog project token — get from posthog.com → Project Settings → Project API Keys
# Leave empty to disable analytics.
VITE_POSTHOG_KEY=
