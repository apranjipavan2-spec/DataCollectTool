# ── API ──────────────────────────────────────────────────────────────────────
# Backend base URL (no trailing slash, no /api/v1 — that's added by api.ts)
VITE_API_BASE_URL=https://your-domain.com/api/v1

# ── Push Notifications ────────────────────────────────────────────────────────
# Optional: if set, used directly without fetching from backend at runtime
# Same value as VAPID_PUBLIC_KEY from backend/.env
VITE_VAPID_PUBLIC_KEY=

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────
# Leave empty to disable Sentry — the app runs fine without it
# Get a DSN from https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
