# ──────────────────────────────────────────────────────────────────────────────
# FieldGovern Backend — Environment Variables
# Copy to .env and fill in all REQUIRED values before starting.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Superuser connection — runs migrations + seeds. Add ?sslmode=require in prod to
# force TLS in transit: postgresql://fieldgovern:CHANGE_ME@host:5432/fieldgovern?sslmode=require
DATABASE_URL=postgresql://fieldgovern:CHANGE_ME@localhost:5432/fieldgovern

# ── Tenant isolation: restricted runtime role (STRONGLY RECOMMENDED for prod) ──
# The app connecting as the superuser above BYPASSES row-level security, so tenant
# isolation would rely on app-code filters alone. Point the request path at the
# non-superuser role `fieldgovern_app` (created/granted by migration 0048) to make
# PostgreSQL enforce isolation at the DB layer. Migrations/seeds keep using
# DATABASE_URL above. Leave APP_DATABASE_URL blank to keep the old behavior.
#   1. Set a strong APP_DB_PASSWORD (migration 0048 applies it to the role).
#   2. Set APP_DATABASE_URL to the fieldgovern_app connection string.
#   3. TEST IN STAGING FIRST: RLS will filter any admin/analytics query that reads
#      tenant tables without a tenant context — fix those before enabling in prod.
APP_DB_PASSWORD=
APP_DATABASE_URL=

# ── Data retention ────────────────────────────────────────────────────────────
# false (default): recycle-bin purge never physically deletes client data; DPDP
# erasure is served by anonymize. Set true only for deliberate ops cleanup.
ALLOW_HARD_DELETE=false

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── Application URL (REQUIRED) ────────────────────────────────────────────────
# Used in email links (password reset, OTP emails).
APP_URL=https://app.fieldgovern.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.fieldgovern.com

# ── Email / SMTP (required for 2FA OTP + password reset emails) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@fieldgovern.com
SMTP_FROM_NAME=FieldGovern

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → OAuth 2.0 Client ID (Web)
# Authorized origins: https://app.fieldgovern.com
# Leave empty to hide the Google Sign-In button.
GOOGLE_CLIENT_ID=

# ── Master Admin bootstrap (used by scripts/create_superuser.py) ──────────────
# Set once before first deploy. Script is idempotent — safe to leave set.
MASTER_ADMIN_PHONE=91XXXXXXXXXX
MASTER_ADMIN_PASSWORD=CHANGE_ME
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_EMAIL=admin@fieldgovern.com

# ── AI / DeepSeek (required for AI features) ──────────────────────────────────
DEEPSEEK_API_KEY=

# ── Error Monitoring (optional) ───────────────────────────────────────────────
SENTRY_DSN=

# ── Web Push Notifications (optional) ────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@fieldgovern.com

# ── WhatsApp via MSG91 (optional) ─────────────────────────────────────────────
MSG91_AUTH_KEY=

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
MEDIA_DIR=uploads

# S3 — only if STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fieldgovern-media
AWS_REGION=ap-south-1
