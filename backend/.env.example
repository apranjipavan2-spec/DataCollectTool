# ──────────────────────────────────────────────────────────────────────────────
# FieldGovern Backend — Environment Variables
# Copy to .env and fill in all REQUIRED values before starting.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://fieldgovern:CHANGE_ME@localhost:5432/fieldgovern

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── Application URL (REQUIRED) ────────────────────────────────────────────────
# Used in email links (password reset, OTP emails).
APP_URL=https://app.fieldgovern.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.fieldgovern.com

# ── Email / SMTP (required for 2FA OTP + password reset emails) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@fieldgovern.com
SMTP_FROM_NAME=FieldGovern

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → OAuth 2.0 Client ID (Web)
# Authorized origins: https://app.fieldgovern.com
# Leave empty to hide the Google Sign-In button.
GOOGLE_CLIENT_ID=

# ── Master Admin bootstrap (used by scripts/create_superuser.py) ──────────────
# Set once before first deploy. Script is idempotent — safe to leave set.
MASTER_ADMIN_PHONE=91XXXXXXXXXX
MASTER_ADMIN_PASSWORD=CHANGE_ME
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_EMAIL=admin@fieldgovern.com

# ── AI / DeepSeek (required for AI features) ──────────────────────────────────
DEEPSEEK_API_KEY=

# ── Error Monitoring (optional) ───────────────────────────────────────────────
SENTRY_DSN=

# ── Web Push Notifications (optional) ────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@fieldgovern.com

# ── WhatsApp via MSG91 (optional) ─────────────────────────────────────────────
MSG91_AUTH_KEY=

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
MEDIA_DIR=uploads

# S3 — only if STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fieldgovern-media
AWS_REGION=ap-south-1
