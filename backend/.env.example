# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fieldpulse:password@localhost:5432/fieldpulse
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ── Media Storage ─────────────────────────────────────────────────────────────
# Options: "local" | "drive" | "s3"
STORAGE_BACKEND=local
MEDIA_DIR=uploads

# Google Drive (when STORAGE_BACKEND=drive)
# Run: python scripts/gdrive_auth.py  to generate gdrive-token.json
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_SECRET_PATH=credentials/gdrive-oauth-client.json
GDRIVE_TOKEN_PATH=credentials/gdrive-token.json

# AWS S3 / Cloudflare R2 (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fieldpulse-media
AWS_REGION=ap-south-1

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
# Generate: python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@fieldpulse.app

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email — the app still runs, emails are skipped
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@fieldpulse.app
SMTP_FROM_NAME=FieldPulse
SMTP_USE_TLS=true

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://your-domain.com
CORS_ORIGINS=["https://your-domain.com"]
